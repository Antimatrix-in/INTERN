# ==============================================================================
# ANTI MATRIX Internship Portal — Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Flask Application Settings
SECRET_KEY=your-secure-random-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5050
BASE_URL=http://localhost:5050

# Database Configuration (Shared Supabase PostgreSQL Database)
# In production, use the SAME Supabase database as the Anti Matrix Portfolio.
# Example Supabase Direct Connection:
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Or Local SQLite (Fallback for testing):
DATABASE_URL=sqlite:///antimatrix.db

# Supabase API Settings (Server-side operations ONLY)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Storage & Upload Configuration
UPLOAD_FOLDER=app/static/uploads
VIDEO_UPLOAD_FOLDER=instance/uploads/videos
MAX_VIDEO_SIZE_MB=100
MAX_CONTENT_LENGTH=125829120

# Primary Administrator Account
ADMIN_EMAIL=admin@antimatrix.ai
ADMIN_PASSWORD=Admin@AntiMatrix2026!

# Session & Security Settings
SESSION_COOKIE_NAME=anti_matrix_session
REMEMBER_COOKIE_NAME=anti_matrix_remember
SESSION_COOKIE_SECURE=false # Set to true in HTTPS production
SESSION_COOKIE_DOMAIN= # Optional domain binding (e.g. intern.antimatrix.co.in)

# Email & Notification Delivery (SMTP Configuration)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=notifications@antimatrix.tech
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Anti-Matrix Portal <notifications@antimatrix.tech>
MAIL_SUPPRESS_SEND=false


